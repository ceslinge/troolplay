POSTGRES_USER=troolplay
POSTGRES_PASSWORD=change-me
POSTGRES_DB=troolplay

# Production seulement : le nom de domaine du site, sans https://.
# SITE_DOMAIN=exemple.fr

# Les emails, en production. Sans SMTP_HOST, ils s'affichent dans le terminal.
# Chez OVH (MX Plan) : ssl0.ovh.net, port 465, l'adresse et le mot de passe de la boîte.
# SMTP_HOST=ssl0.ovh.net
# SMTP_PORT=465
# SMTP_USER=contact@exemple.fr
# SMTP_PASSWORD=
# MAIL_FROM=

# La copie des sauvegardes hors du serveur (un stockage compatible S3). Sans S3_BUCKET,
# les sauvegardes restent seulement sur le serveur. Chez OVH : Object Storage, dans une
# autre région que le serveur ; l'adresse et la région sont affichées à la création.
# S3_BUCKET=troolplay-sauvegardes
# S3_ENDPOINT=https://s3.sbg.io.cloud.ovh.net
# S3_REGION=sbg
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
