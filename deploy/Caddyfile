# SITE_DOMAIN : le nom de domaine du site. Caddy obtient et renouvelle seul le certificat HTTPS.
{$SITE_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# Les feuilles de style viennent du site ; seuls les attributs style="…" des composants
		# sont permis en ligne, jamais une balise <style> (#56).
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; style-src-attr 'unsafe-inline'; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		# Une autre fenêtre ou un autre site ne peut ni piloter cet onglet, ni charger nos fichiers.
		Cross-Origin-Opener-Policy same-origin
		Cross-Origin-Resource-Policy same-origin
		-Server
	}

	# L'API, sans son préfixe : le backend ne connaît que /characters, /me…
	handle_path /api/* {
		# Une histoire au plus long pèse environ 50 Ko : au-delà d'1 Mo, la requête
		# est refusée ici, avant d'occuper l'API.
		request_body {
			max_size 1MB
		}
		reverse_proxy backend:8000
	}

	# Les robots d'aperçu (Discord, Slack, WhatsApp…) lisent la page sans JavaScript : pour
	# une fiche ou une histoire, l'API leur sert une page de balises d'aperçu (#53).
	# Les humains reçoivent le site, comme pour toute autre adresse.
	@apercu {
		path_regexp ^/(personnages|histoires)/[0-9]+$
		header_regexp User-Agent (?i)(discordbot|slackbot|twitterbot|facebookexternalhit|whatsapp|telegrambot|linkedinbot|mastodon|embedly|skypeuripreview|redditbot)
	}
	handle @apercu {
		rewrite * /preview{path}
		reverse_proxy backend:8000
	}

	handle {
		root * /srv
		# Les fichiers construits portent leur empreinte dans leur nom : on peut les garder un an.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		# Une adresse du site (/communaute/3…) n'est pas un fichier : React s'en charge.
		try_files {path} /index.html
		file_server
	}

	# Les adresses IP ne restent que 30 jours (page de confidentialité).
	log {
		output file /data/logs/access.log {
			roll_keep_for 720h
		}
	}
}
